# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# ===== SMB-шара =====
# Если пусто — сканер работает в режиме bind-mount (см. README).
SMB_SHARE=
# Пользователь для маунта, например mynas\user или user@domain
SMB_USER=
# Пароль (альтернатива файлу secrets/password.txt)
SMB_PASS=
# Файл с паролем внутри контейнера (по умолчанию маунтится ./secrets/password.txt)
SMB_PASS_FILE=/secrets/password.txt
# Доп. опции mount.cifs
SMB_OPTS=,vers=3.0,noperm,cache=none
# Точка монтирования внутри контейнера
SMB_MOUNT=/mnt/share